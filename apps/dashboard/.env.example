# fixture = canned demo data (always works). live = read Sepolia / Solana devnet / Cardano preprod.
# Default: live when NEXT_PUBLIC_REGISTRY_ADDRESS is set, otherwise fixture.
DATA_MODE=fixture

# Sepolia AttestationRegistry (contracts/evm/src/AttestationRegistry.sol)
NEXT_PUBLIC_REGISTRY_ADDRESS=
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Block the registry was deployed at. Log scans start here.
REGISTRY_DEPLOY_BLOCK=

# Registry agent ids (keccak256 of these labels, same as workflows/cre id32)
AGENT_EVM_ID=attesta-demo-agent-1
AGENT_SOLANA_ID=attesta-demo-agent-2
AGENT_CARDANO_ID=attesta-demo-agent-3

# Solana guard (programs/solana, devnet)
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_GUARD_PROGRAM_ID=2ppMVjwBs8dqNppcJctfTJaVb3rtfFFe5cDmJyxCGuSW
# Agent pubkey governed by the guard (policy PDA = ["policy", agent])
SOLANA_AGENT_PUBKEY=

# Cardano preprod x402 seller address; incoming txs = attestation purchases
CARDANO_SELLER_ADDRESS=addr_test1qztvnhavscfaupuwy824jem5z8dxavkzz6ukg4xyzls3gn2mejfgg4sl7sj4rdxxdnzsqvpkzwu0v39338t9aj6p6q7stjznf6
KOIOS_URL=https://preprod.koios.rest/api/v1

# Optional override for the control catalogue (defaults to ../../controls/catalog.json)
CONTROLS_CATALOG_PATH=

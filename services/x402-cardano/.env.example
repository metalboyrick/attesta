# Secrets (MNEMONIC, SELLER_MNEMONIC, SELLER_ADDRESS) live in
# ~/.attesta-secrets/cardano-preprod.env, written by `npm run wallet`.
# Override that path with ATTESTA_CARDANO_SECRETS. Nothing secret goes here.

# Cardano Foundation hosted facilitator (preprod). Local: http://localhost:4022
FACILITATOR_URL=https://x402.preprod.dev.ecosyseng.cf-deployments.org
SELLER_PORT=4021
# PRICE_LOVELACE=1000000

# Chain provider for the buyer (and local facilitator). Blockfrost if set,
# otherwise public Koios preprod with no key.
# BLOCKFROST_PROJECT_ID=
# KOIOS_BASE_URL=https://preprod.koios.rest/api/v1
# SELLER_URL=http://localhost:4021

# Local facilitator on Koios can only prove block inclusion: set 0 with it.
# Leave unset for the hosted facilitator (spec default 1).
# L1_CONFIRMATIONS=0

# Attestation source. Both set -> read Sepolia AttestationRegistry. Without
# them the seller fails closed (503) unless ATTESTA_STUB=1 enables test data.
# Live Attesta AttestationRegistry on Sepolia (public address).
ATTESTA_REGISTRY_ADDRESS=0xbc675484a8c2c51174efb8b5369250eb8337750d
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# ATTESTA_STUB=1
# agentId -> bytes32: keccak256(utf8) by default, or "utf8" for right-padded.
# AGENT_ID_ENCODING=keccak
# ATTESTA_CONTROL_IDS=ATT-SPEND-01,ATT-CPTY-02,ATT-KEY-03,ATT-TXLIM-04,ATT-FRZ-05,ATT-CHG-06,ATT-LOG-07,ATT-HITL-08

# Price asset: "lovelace" (default, PRICE_LOVELACE) or "usdm" (PRICE_USDM
# atomic units of USDM_UNIT, default 1 tUSDM of @x402/cardano's preprod USDM
# e675b46e..., which the tusdm.moneta.global faucet sends. Masumi uses 16a55b2a...).
# PRICE_ASSET=lovelace
# PRICE_USDM=1000000
# USDM_UNIT=e675b46e4d2242c991a8932a99db3044e80515ae14b4c4ccf6b3f4c9.0014df10745553444d

# Paid (agentId, nonce) receipts for idempotent retries.
# RECEIPTS_FILE=.data/receipts.json

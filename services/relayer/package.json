{
  "name": "@attesta/relayer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mirrors failing Attesta control results from Sepolia to the Solana guard (freeze), and collects Solana guard spend as SpendRecords.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "relay": "tsx src/relayer.ts",

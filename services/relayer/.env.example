# Source: Sepolia AttestationRegistry
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ATTESTA_REGISTRY_ADDRESS=0x48a80a9d7e319c29e5e309d7932c467810680935
# Registry deploy block. Required when there is no saved state for this address.
# The relayer never starts at head, so FAILs written while it was down still freeze.
REGISTRY_DEPLOY_BLOCK=11857427

# Target: Solana attesta_guard (devnet)
SOLANA_RPC_URL=https://api.devnet.solana.com
# agentId (string the registry hashes with keccak256) = Solana agent pubkey
SOLANA_AGENTS=attesta-demo-agent-2=2pVzN7yA5qS6ozXVpxkwiSQhHy9362L9mrHwbVSBJfmM
SOLANA_AUTHORITY_KEYPAIR=~/.attesta-secrets/solana-authority.json
SOLANA_PAYER_KEYPAIR=~/.attesta-secrets/solana-deployer.json

# Keep 0. ATT-FRZ-05: a person unfreezes (`pnpm unfreeze`). 1 = auto-unfreeze on PASS, local tests only.
AUTO_UNFREEZE=0
RELAYER_POLL_MS=12000
# Blocks to wait before acting on a log (reorg safety)
RELAYER_CONFIRMATIONS=2
# Failed attempts before a log is dead-lettered (reconcile still freezes from failingCount)
RELAYER_MAX_ATTEMPTS=5
RELAYER_STATE_FILE=.relayer-state.json
